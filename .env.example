# Required secrets. Copy this file to .env.local, replace every placeholder, and never commit it.
MINIO_ROOT_USER=vortex-local
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
VORTEX_SECURITY_BEARER_TOKEN=replace-with-a-long-random-token

# Required authorization boundary. Comma-separated Ant-style namespace patterns are supported.
VORTEX_SECURITY_NAMESPACE_PATTERNS=quickstart-*

# Optional security and published API settings.
VORTEX_IMAGE=ghcr.io/haibaraai2517/vortex:0.2.0
VORTEX_RELEASE_VERSION=0.2.0
VORTEX_SECURITY_REQUESTS_PER_MINUTE=600
VORTEX_HTTP_PORT=8080

# Development-only host ports used by docker-compose.yml. Quickstart does not publish storage ports.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MILVUS_PORT=19530
MILVUS_MANAGEMENT_PORT=9091
REDIS_PORT=6379

# Dangerous migration controls stay unset unless a reviewed migration runbook explicitly requires them.
MILVUS_DROP_COLLECTION=false
MILVUS_DROP_CONFIRM_TOKEN=
